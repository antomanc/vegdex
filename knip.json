{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", "apps/web/src/lib/WellkeptAllowEffects.svelte", "apps/web/src/lib/WellkeptAllowTimers.svelte"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["e2e/emit-fixtures.ts"]
    },
    "apps/web": {
      "ignoreDependencies": ["@inlang/plugin-message-format"]
    },
    "packages/ingest": {
      "entry": ["src/nightly-cli.ts", "src/parse-diff.ts", "src/golden-lines.ts", "scripts/*.ts"]
    }
  }
}
