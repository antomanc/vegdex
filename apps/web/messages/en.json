  "recipe_count": [
    {
      "declarations": [
        "input count",
        "input plural"
      ],
      "selectors": [
        "plural"
      ],
      "match": {
        "plural=one": "{count} recipe",
        "plural=*": "{count} recipes"
      }
    }
  ],
  "saved_count": [
    {
      "declarations": [
        "input count",
        "input plural"
      ],
      "selectors": [
        "plural"
      ],
      "match": {
        "plural=one": "{count} recipe saved",
        "plural=*": "{count} recipes saved"
      }
    }
  ],
  "show_recipes": [
    {
      "declarations": [
        "input count",
        "input plural"
      ],
      "selectors": [
        "plural"
      ],
      "match": {
        "plural=one": "Show {count} recipe",
        "plural=*": "Show {count} recipes"
      }
    }
  ],
  "blog_count": [
    {
      "declarations": [
        "input count",
        "input plural"
      ],
      "selectors": [
        "plural"
      ],
      "match": {
        "plural=one": "from {count} vegan blog",
        "plural=*": "from {count} vegan blogs"
      }
    }
