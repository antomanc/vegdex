{
  "version": 1,
  "rules": [
    {
      "id": "effects-in-reactive-only",
      "kind": "api",
      "message": "Use $derived for values, latest() for worker questions, intersect() for observers and flash()/settled() for timed state (apps/web/src/lib/reactive); when none fits, add a helper there named for its job, with a test beside it.",
      "source": "wellkept audit: 12 effects in App.svelte, latest-answer guard written three times",
      "enforcedBy": "wellkept-check probe",
      "check": "node scripts/wellkept-check.mjs",
      "probe": {
        "pattern": "\\$effect(\\.pre)?\\s*\\(",
        "include": [
          "apps/web/src/**/*.svelte",
          "apps/web/src/**/*.ts"
        ],
        "exclude": [
          "apps/web/src/lib/reactive/*.svelte.ts"
        ]
      },
      "canary": {
        "path": "apps/web/src/lib/WellkeptCanary.svelte",
        "content": "<script lang=\"ts\">\n  $effect(() => {})\n</script>\n",
        "expect": "[effects-in-reactive-only]"
      },
      "added": "2026-11-16",
      "baseline": {
        "apps/web/src/App.svelte": 4,
        "apps/web/src/lib/FilterBar.svelte": 1,
        "apps/web/src/lib/GrocerySheet.svelte": 2,
        "apps/web/src/lib/RecipeSheet.svelte": 1
      },
      "raised": [
        {
          "date": "2026-11-16",
          "from": 8,
          "to": 11,
          "reason": "lib/reactive now has its own ceiling: latest, intersect and settled each hold one effect"
        }
      ],
      "allow": {
        "path": "apps/web/src/lib/WellkeptAllowEffects.svelte",
        "content": "<script lang=\"ts\">\n  import { latest } from './reactive/latest.svelte'\n\n  let { count }: { count: (query: string) => Promise<number> } = $props()\n  let query = $state('')\n  let found = $state(0)\n  let failed = $state(false)\n  const label = $derived(failed ? 'offline' : found + ' recipes')\n  latest(\n    () => count(query),\n    (n) => ((found = n), (failed = false)),\n    () => (failed = true)\n  )\n</script>\n\n<input bind:value={query} />\n<p>{label}</p>\n"
      }
    },
    {
      "id": "timers-in-reactive-only",
      "kind": "api",
      "message": "Wait for the event itself (transitionend, a promise, tick(), an observer) or use flash()/settled() from apps/web/src/lib/reactive; a timer that patches over ordering spreads. When none fits, add a helper there named for its job, with a test beside it.",
      "source": "wellkept audit",
      "enforcedBy": "wellkept-check probe",
      "check": "node scripts/wellkept-check.mjs",
      "probe": {
        "pattern": "\\b(setTimeout|setInterval|requestAnimationFrame|requestIdleCallback)\\s*\\(",
        "include": [
          "apps/web/src/**/*.svelte",
          "apps/web/src/**/*.ts"
        ],
        "exclude": [
          "apps/web/src/lib/reactive/*.svelte.ts"
        ]
      },
      "canary": {
        "path": "apps/web/src/lib/wellkept-canary.ts",
        "content": "export const wellkeptCanary = () => setTimeout(() => {}, 300)\n",
        "expect": "[timers-in-reactive-only]"
      },
      "added": "2026-11-16",
      "baseline": {
        "apps/web/src/App.svelte": 1,
        "apps/web/src/lib/IngredientField.svelte": 2
      },
      "raised": [
        {
          "date": "2026-11-16",
          "from": 3,
          "to": 5,
          "reason": "lib/reactive now has its own ceiling: flash and settled each hold one timer"
        }
      ],
      "allow": {
        "path": "apps/web/src/lib/WellkeptAllowTimers.svelte",
        "content": "<script lang=\"ts\">\n  import { flash, settled } from './reactive/timing.svelte'\n\n  let text = $state('')\n  const copied = flash(2000)\n  const typed = settled(() => text, 300, '')\n</script>\n\n<input bind:value={text} />\n<button onclick={() => copied.show()}>{copied.on ? 'Copied' : typed.current}</button>\n"
      }
    },
    {
      "id": "no-passthrough-helpers",
      "kind": "pattern",
      "message": "A helper in lib/reactive owns one job (the latest answer, an observer, a timed flag); it must not hand a caller's callback straight to $effect or a timer. Write the helper named for that job instead.",
      "source": "wellkept re-run: lib/reactive is exempt from the effect and timer rules, so a generic effect() or sleep() there would smuggle them out",
      "enforcedBy": "wellkept-check probe",
      "check": "node scripts/wellkept-check.mjs",
      "probe": {
        "pattern": "(\\$effect(\\.pre)?|\\b(setTimeout|setInterval|requestAnimationFrame|requestIdleCallback))\\s*\\(\\s*(\\(\\s*\\)\\s*=>\\s*)?[A-Za-z_$][\\w$.]*(\\(\\s*\\))?\\s*[,)]",
        "include": [
          "apps/web/src/lib/reactive/**"
        ]
      },
      "canary": {
        "path": "apps/web/src/lib/reactive/wellkept-smuggle.svelte.ts",
        "content": "export const later = (run: () => void, ms: number) => setTimeout(run, ms)\n",
        "expect": "[no-passthrough-helpers]"
      },
      "added": "2026-11-16"
    },
    {
      "id": "reactive-helpers-tested",
      "kind": "pattern",
      "message": "A helper in lib/reactive needs a test beside it that covers teardown, changing inputs and separate instances; the folder is exempt from the effect and timer rules, so its tests are what keep its lifecycle right.",
      "source": "wellkept re-run: every helper has a test; flash() leaked its timer until it had one",
      "enforcedBy": "scripts/check-helper-tests.mjs",
      "check": "node scripts/check-helper-tests.mjs",
      "canary": {
        "path": "apps/web/src/lib/reactive/wellkept-canary.svelte.ts",
        "content": "export const wellkeptCanary = () => 1\n",
        "expect": "[reactive-helpers-tested]"
      },
      "added": "2026-11-16"
    },
    {
      "id": "ts-escape-hatches",
      "kind": "pattern",
      "message": "Fix the type or the markup instead of silencing the checker.",
      "source": "wellkept audit",
      "enforcedBy": "wellkept-check probe",
      "check": "node scripts/wellkept-check.mjs",
      "probe": {
        "pattern": "\\bas any\\b|as unknown as|@ts-ignore|@ts-expect-error|@ts-nocheck|eslint-disable|svelte-ignore",
        "include": [
          "apps/web/src/**/*.svelte",
          "apps/web/src/**/*.ts",
          "packages/*/src/**/*.ts"
        ]
      },
      "canary": {
        "path": "apps/web/src/lib/wellkept-canary.ts",
        "content": "// @ts-ignore\nexport const wellkeptCanary = 1\n",
        "expect": "[ts-escape-hatches]"
      },
      "added": "2026-11-16",
      "baseline": {
        "apps/web/src/lib/IngredientField.svelte": 1
      }
    },
    {
      "id": "fixtures-current",
      "kind": "behavior",
      "message": "The e2e fixtures are out of date with the parser and vocabulary: commit what pnpm fixtures writes to e2e/fixtures.",
      "source": "docs/agents/testing.md (\"the committed fixtures can lag the line records\"), replaced there",
      "enforcedBy": "scripts/check-fixtures.mjs (pnpm fixtures:check)",
      "check": "node scripts/check-fixtures.mjs",
      "canary": {
        "path": "e2e/fixtures/data/wellkept-canary.json",
        "content": "{}\n",
        "expect": "out of date"
      },
      "added": "2026-11-16"
    }
  ],
  "declined": [
    {
      "id": "linter",
      "reason": "wellkept-check carries the regex rules. no-passthrough-helpers reads a call shape with a regex, which catches the passthroughs tried (a callback handed to $effect or a timer, directly or as () => fn()); a parser is not yet worth a new tool for it",
      "date": "2026-11-16",
      "revisitWhen": "a passthrough slips past no-passthrough-helpers, a regex rule misfires (a raised ceiling that is a false positive), or a rule needs imports"
    },
    {
      "id": "comment-ban",
      "reason": "comments explain domain decisions; parser examples are covered by the golden set",
      "date": "2026-11-16",
      "revisitWhen": "comments start defending shortcuts (a workaround, hack, temporary fix or kludge comment in source or tests)",
      "revisitProbe": {
        "pattern": "^\\s*(\\/\\/|#|\\*|\\/\\*).*\\b(workaround|hack|for now|temporar(y|ily) (fix|hack|workaround|patch)|quick fix|band-?aid|not ideal|ugly|kludge|needed because|otherwise .* (breaks|fails))",
        "flags": "i",
        "include": [
          "apps/web/src/**/*.ts",
          "apps/web/src/**/*.svelte",
          "apps/web/*.ts",
          "packages/*/src/**/*.ts",
          "packages/*/scripts/**/*.ts",
          "packages/*/test/**/*.ts",
          "e2e/**/*.ts",
          "tests/**/*.ts",
          "scripts/**/*.mjs"
        ],
        "exclude": [
          "scripts/wellkept-check.mjs"
        ]
      }
    },
    {
      "id": "boundaries",
      "reason": "pnpm workspace dependencies already stop web from importing ingest",
      "date": "2026-11-16",
      "revisitWhen": "a package gains a dependency that crosses web, core and ingest",
      "revisitProbe": {
        "pattern": "\"@vegdex/(web|ingest)\"\\s*:|\\bfrom\\s+[\"']@vegdex/(web|ingest)\\b|\\bimport\\(\\s*[\"']@vegdex/(web|ingest)\\b|[\"'](\\.\\./)+(packages/ingest|ingest|apps/web|web)/",
        "include": [
          "apps/web/package.json",
          "packages/core/package.json",
          "packages/ingest/package.json",
          "apps/web/src/**",
          "apps/web/*.ts",
          "packages/core/src/**",
          "packages/ingest/src/**"
        ]
      }
    },
    {
      "id": "timers-outside-web",
      "reason": "ingest sleeps between polite crawl requests; core takes its scheduler as a parameter",
      "date": "2026-11-16",
      "revisitWhen": "a timer appears in core or ingest outside the crawler",
      "revisitProbe": {
        "pattern": "\\b(setTimeout|setInterval|requestAnimationFrame|requestIdleCallback)\\s*\\((?!next\\)|resolve, ms\\)|\\(\\) => saveStore\\()",
        "include": [
          "packages/core/src/**",
          "packages/ingest/src/**",
          "packages/ingest/scripts/**"
        ]
      }
    }
  ],
